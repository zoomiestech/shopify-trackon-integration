# ----------------------------
# Server
# ----------------------------
PORT=3000
NODE_ENV=development

# Public HTTPS URL after deploy/tunnel.
# Example: https://shopify-trackon-integration.onrender.com
PUBLIC_BASE_URL=

# Protects /admin/* endpoints. Use a long random value.
ADMIN_API_KEY=change-this-to-a-long-random-secret

# ----------------------------
# MongoDB Atlas
# ----------------------------
# Example:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=shopify_trackon

# ----------------------------
# Shopify
# ----------------------------
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SHOP=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Use client_credentials when the app and store are in the same Shopify
# Dev Dashboard organisation. Use oauth otherwise.
SHOPIFY_AUTH_MODE=client_credentials

SHOPIFY_SCOPES=read_orders,write_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders

# Which Shopify webhook creates a Trackon shipment:
# orders_create OR orders_paid
BOOKING_TRIGGER=orders_create

SHOPIFY_NOTIFY_CUSTOMER=false
SHOPIFY_SYNC_TRACKING_METAFIELDS=true

# Optional legacy/static Admin API token.
SHOPIFY_ACCESS_TOKEN=

# ----------------------------
# Trackon
# ----------------------------
# KEEP TRUE until Shopify + MongoDB testing is complete.
TRACKON_MOCK=true

TRACKON_BOOKING_URL=https://api.trackon.in/CrmApi/Crm/UploadPickupRequestWithoutDockNo
TRACKON_TRACKING_URL=https://api.trackon.in/CrmApi/t1/AWBTrackingCustomer

TRACKON_APP_KEY=
TRACKON_USER_ID=
TRACKON_PASSWORD=

TRACKON_CUSTOMER_CODE=
TRACKON_PICKUP_CUSTOMER_CODE=

TRACKON_TYPE_OF_SERVICE=
TRACKON_SERVICE_TYPE=Parcel

# The supplied Trackon PDF gives fields but not a definitive full request
# example. Start with json; use form if Trackon confirms form-urlencoded.
TRACKON_BOOKING_BODY_MODE=json

TRACKON_DEFAULT_WEIGHT_KG=1
TRACKON_DEFAULT_PIECES=1

# Only needed when TRACKON_PICKUP_CUSTOMER_CODE is blank
PICKUP_NAME=
PICKUP_ADDRESS=
PICKUP_CITY=
PICKUP_STATE=
PICKUP_PINCODE=
PICKUP_PHONE=

TRACKING_POLL_MINUTES=60
TRACKON_TIMEOUT_MS=15000
