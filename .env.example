# ----------------------------
# Server
# ----------------------------
PORT=3000
NODE_ENV=development

# Public HTTPS URL of this app after deploy/tunnel.
# Example: https://trackon-bridge.example.com
PUBLIC_BASE_URL=

# Used to protect /admin/* endpoints. Make this a long random string.
ADMIN_API_KEY=change-this-to-a-long-random-secret

# Persistent JSON store.
DATA_FILE=./data/store.json

# ----------------------------
# Shopify
# ----------------------------
# Latest stable version at the time this package was generated.
SHOPIFY_API_VERSION=2026-07

# Full myshopify domain, e.g. zoomies-test.myshopify.com
SHOPIFY_SHOP=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# client_credentials = easiest when app + store are in same Shopify organization.
# oauth = use for a standalone/API-only app installed on a store outside your organization.
SHOPIFY_AUTH_MODE=client_credentials

# Required API scopes.
SHOPIFY_SCOPES=read_orders,write_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders

# Which Shopify webhook actually creates the Trackon shipment:
# orders_create OR orders_paid
BOOKING_TRIGGER=orders_create

# If true, Shopify sends its fulfillment/tracking email when fulfillment is created.
SHOPIFY_NOTIFY_CUSTOMER=false

# Save latest Trackon status to Shopify order metafields.
SHOPIFY_SYNC_TRACKING_METAFIELDS=true

# Optional: if you already maintain an older app/token, you can place an Admin API token here.
# Normal new setups should leave this blank and use client_credentials or oauth.
SHOPIFY_ACCESS_TOKEN=

# ----------------------------
# Trackon
# ----------------------------
# Keep true for initial Shopify testing. No real Trackon request is sent.
TRACKON_MOCK=true

TRACKON_BOOKING_URL=https://api.trackon.in/CrmApi/Crm/UploadPickupRequestWithoutDockNo
TRACKON_TRACKING_URL=https://api.trackon.in/CrmApi/t1/AWBTrackingCustomer

TRACKON_APP_KEY=
TRACKON_USER_ID=
TRACKON_PASSWORD=

TRACKON_CUSTOMER_CODE=
TRACKON_PICKUP_CUSTOMER_CODE=

# Confirm these with Trackon for your account.
TRACKON_TYPE_OF_SERVICE=
TRACKON_SERVICE_TYPE=Parcel

# The PDF lists a POST endpoint/fields but not a full request example.
# Use json first. Switch to form if Trackon confirms application/x-www-form-urlencoded.
TRACKON_BOOKING_BODY_MODE=json

TRACKON_DEFAULT_WEIGHT_KG=1
TRACKON_DEFAULT_PIECES=1

# Used only when TRACKON_PICKUP_CUSTOMER_CODE is blank
PICKUP_NAME=
PICKUP_ADDRESS=
PICKUP_CITY=
PICKUP_STATE=
PICKUP_PINCODE=
PICKUP_PHONE=

# Poll active shipments every N minutes.
TRACKING_POLL_MINUTES=60

# HTTP request timeout to Trackon
TRACKON_TIMEOUT_MS=15000
